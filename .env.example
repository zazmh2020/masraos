# ============================================================
#  مسرى — متغيّرات البيئة (انسخ إلى .env محليًا، واضبطها على المستضيف للإنتاج)
#  لا تُودِع .env في Git إطلاقًا.
# ============================================================

# ---- أساسية (مطلوبة) ----
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-ENDPOINT.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# سرّ توقيع الجلسات — ولّد قيمة قويّة وفريدة للإنتاج:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="GENERATE_A_STRONG_RANDOM_VALUE"
# نطاق(ات) الجذر لتوجيه النطاقات الفرعية للجهات (admin.<root> و<slug>.<root>).
# للإنتاج ضع نطاقك الحقيقي (يمكن فصل عدة نطاقات بفواصل).
APP_ROOT_DOMAINS="masraos.com"
# النطاق الأساسي الظاهر في روابط لوحة المالك وروابط المؤسسات (بدون بروتوكول).
# للإنتاج: masraos.com — للتطوير المحلّي اتركه فارغًا (الافتراضي midad.localhost:3000).
NEXT_PUBLIC_APP_DOMAIN="masraos.com"

# ---- الأمان في الإنتاج ----
# اتركه فارغًا/غير مضبوط في الإنتاج. ضبطه على "1" يفعّل الدخول التجريبي بلا كلمة مرور = ثغرة خطيرة.
# ENABLE_DEMO_LOGIN=

# ---- الدفع والاشتراكات (Stripe) ----
# من لوحة Stripe. الأسعار: أنشئ منتجًا/سعرًا شهريًا لكل باقة مدفوعة وضع معرّف السعر (price_...).
STRIPE_SECRET_KEY=""              # sk_live_... (أو sk_test_... للتجربة)
STRIPE_WEBHOOK_SECRET=""          # whsec_... (من إعداد الـ webhook على /api/webhooks/stripe)
STRIPE_PRICE_GROWTH=""            # price_... لباقة «نمو»
STRIPE_PRICE_PROFESSIONAL=""      # price_... لباقة «احترافي»

# ---- البريد (اختياري — يفعّل إرسال التقارير والتنبيهات) ----
RESEND_API_KEY=""                 # من resend.com
EMAIL_FROM="مسرى <no-reply@masraos.com>"

# ---- تخزين الوثائق (متوافق مع S3: AWS S3 / Cloudflare R2 / MinIO / Backblaze) ----
# اترك S3_ENDPOINT فارغًا لـ AWS S3. لـ R2/MinIO ضع نقطة النهاية الكاملة.
S3_BUCKET=""
S3_REGION="auto"              # AWS: us-east-1 مثلاً | R2: auto
S3_ENDPOINT=""                # R2: https://<account>.r2.cloudflarestorage.com | MinIO: http://localhost:9000
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"   # true لـ MinIO

# ---- المساعد الذكي (Claude) ----
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"   # اختياري — النموذج الافتراضي

# ---- مراقبة الأخطاء (اختياري) ----
# عند ضبطه تُرسل بلاغات الأخطاء إلى هذا الرابط (Slack/Discord Webhook أو مخصّص).
# اتركه فارغًا للاكتفاء بسجلّات المستضيف (Vercel Logs). للمراقبة المتقدّمة استخدم Sentry بدلاً منه.
ERROR_WEBHOOK_URL=""
