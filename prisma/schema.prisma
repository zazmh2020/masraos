generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // رابط الاتصال يُقرأ من prisma.config.ts (Prisma v7)
}

/// المؤسسة — كل مؤسسة بيئة معزولة عن غيرها
model Organization {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique // يُستخدم في الدومين الفرعي والمسار
  type                 OrgType   @default(ASSOCIATION)
  isActive             Boolean   @default(true)
  plan                 OrgPlan   @default(STARTER)
  planRenewsAt         DateTime?
  stripeCustomerId     String?   @unique // معرّف العميل في Stripe
  stripeSubscriptionId String? // معرّف الاشتراك النشط
  subscriptionStatus   String? // active / trialing / past_due / canceled …
  pointsPerScan        Int       @default(10) // نقاط مسابقة الباركود لكل مسح
  pointsBoardRotateSec Int       @default(15) // مدة تدوير صفحات لوحة الترتيب (ثوانٍ)
  brandColor           String? // لون الهوية الأساسي للجهة (hex)
  brandAccent          String? // لون ثانوي/مميّز (hex)
  logoUrl              String? // شعار الجهة (رابط)
  faviconUrl           String? // أيقونة التبويب (رابط)
  coverUrl             String? // صورة غلاف للموقع العام (رابط)
  tagline              String? // شعار نصّي قصير
  customDomain         String? // دومين مخصّص يُنشئه مالك المنصّة (يُتحقّق من تفرّده في الـ API)
  websiteUrl           String? // الموقع الإلكتروني
  twitterUrl           String? // رابط منصّة X/تويتر
  instagramUrl         String? // رابط إنستغرام
  whatsapp             String? // رقم واتساب للتواصل
  disabledModules      String[]  @default([]) // وحدات معطّلة لهذه المؤسسة (المفعّلة = الباقي)
  sitePublished        Boolean   @default(false) // نشر الموقع العام للمؤسسة
  contactEmail         String? // بيانات تواصل عامة
  contactPhone         String?
  address              String?
  aboutText            String? // نبذة تُعرض في الموقع العام
  quranSummaryLabels   Json? // مسميات جدول نهاية الشهر المخصّصة لهذا المركز
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  users               User[]
  projects            Project[]
  departments         Department[]
  programs            Program[]
  campaigns           Campaign[]
  beneficiaries       Beneficiary[]
  donations           Donation[]
  articles            KnowledgeArticle[]
  documents           Document[]
  teachers            Teacher[]
  students            Student[]
  halaqat             Halaqa[]
  attendance          AttendanceRecord[]
  memorization        MemorizationEntry[]
  announcements       Announcement[]
  competitions        Competition[]
  employees           Employee[]
  volunteers          Volunteer[]
  teams               Team[]
  tasks               Task[]
  quranRecords        QuranDailyRecord[]
  requests            MemberRequest[]
  fees                StudentFee[]
  events              Event[]
  auditLogs           AuditLog[]
  competitionEntrants CompetitionParticipant[]
  branches            Branch[]
  approvals           Approval[]
  assessments         Assessment[]
  customRoles         CustomRole[]
  guardians           Guardian[]
  financeTransactions FinanceTransaction[]
  messages            Message[]
  studyPlans          StudyPlan[]
  pointsTransactions  PointsTransaction[]

  @@map("organizations")
}

/**
 * ============================================================
 * الموارد البشرية
 * ============================================================
 */

/// الموظف
model Employee {
  id        String         @id @default(cuid())
  name      String
  phone     String?
  email     String?
  position  String?
  hireDate  DateTime?
  status    EmployeeStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([departmentId])
  @@map("employees")
}

enum EmployeeStatus {
  ACTIVE // على رأس العمل
  ON_LEAVE // في إجازة
  TERMINATED // منتهية خدمته
}

/// المتطوّع
model Volunteer {
  id        String          @id @default(cuid())
  name      String
  phone     String?
  skills    String?
  status    VolunteerStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("volunteers")
}

enum VolunteerStatus {
  ACTIVE // نشط
  INACTIVE // غير نشط
}

/// فريق عمل
model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  lead        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([departmentId])
  @@map("teams")
}

/**
 * ============================================================
 * نظام التعليم / الحلقات القرآنية
 * ============================================================
 */

/// المعلّم — قد لا يكون مستخدمًا في النظام
model Teacher {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  specialization String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  halaqat        Halaqa[]

  // ربط سجلّ المعلّم بحساب دخول (اختياري) — لعرض «حلقاتي»
  userId String? @unique
  user   User?   @relation("TeacherAccount", fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("teachers")
}

/// الطالب — قد ينتمي لحلقة واحدة
model Student {
  id            String          @id @default(cuid())
  serial        Int? // رقم تسلسلي تلقائي للطالب داخل الجهة
  section       StudentSection? // القسم: بنين/بنات
  name          String
  phone         String?
  guardianName  String?
  guardianPhone String?
  birthDate     DateTime?
  status        StudentStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  halaqaId String?
  halaqa   Halaqa? @relation(fields: [halaqaId], references: [id], onDelete: SetNull)

  guardianEmail String? // بريد وليّ الأمر — لإرسال التقارير

  // ربط الطالب بسجلّ وليّ أمر له حساب متابعة (اختياري)
  guardianId  String?
  guardianRef Guardian? @relation(fields: [guardianId], references: [id], onDelete: SetNull)

  // ربط الطالب بحساب دخول (اختياري) — لبوّابة الطالب
  userId  String? @unique
  account User?   @relation("StudentAccount", fields: [userId], references: [id], onDelete: SetNull)

  attendance   AttendanceRecord[]
  memorization MemorizationEntry[]
  quranRecords QuranDailyRecord[]
  fees         StudentFee[]
  assessments  Assessment[]
  pointsTransactions PointsTransaction[]

  @@index([organizationId])
  @@index([organizationId, serial])
  @@index([halaqaId])
  @@index([guardianId])
  @@map("students")
}

/// رسم دراسي/اشتراك لطالب
model StudentFee {
  id        String    @id @default(cuid())
  title     String
  amount    Int
  dueDate   DateTime?
  paid      Boolean   @default(false)
  paidAt    DateTime?
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([studentId])
  @@map("student_fees")
}

/// حركة نقاط (مسابقة الباركود) — دفتر أستاذ: كل مسح/خصم/تعديل حركة مستقلة، والرصيد يُحسب منها.
model PointsTransaction {
  id             String       @id @default(cuid())
  kind           PointsKind // EARN / DEDUCT / ADJUST
  source         PointsSource @default(SCAN)
  amount         Int // موجب دائمًا؛ الاتجاه من kind
  balanceAfter   Int // الرصيد بعد هذه الحركة (مزامنة موثوقة)
  reason         String?
  idempotencyKey String?      @unique // منع تكرار/Replay لنفس العملية
  createdAt      DateTime     @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("PointsCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([studentId])
  @@index([organizationId, createdAt])
  @@map("points_transactions")
}

enum PointsKind {
  EARN // اكتساب (مسح)
  DEDUCT // خصم (استبدال)
  ADJUST // تعديل يدوي
}

enum PointsSource {
  SCAN // من قارئ الباركود
  MANUAL // إدخال يدوي
  REDEEM // استبدال/خصم
}

/// حركة مالية — دخل أو مصروف ضمن دفتر الجهة الموحّد
model FinanceTransaction {
  id          String          @id @default(cuid())
  kind        FinanceKind
  category    FinanceCategory @default(OTHER)
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime        @default(now())
  description String?
  createdAt   DateTime        @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("FinanceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([date])
  @@map("finance_transactions")
}

enum FinanceKind {
  INCOME // دخل
  EXPENSE // مصروف
}

enum FinanceCategory {
  SALARY // رواتب
  RENT // إيجار
  UTILITIES // خدمات (كهرباء/ماء/إنترنت)
  SUPPLIES // مستلزمات
  MAINTENANCE // صيانة
  FEES // رسوم/اشتراكات
  DONATIONS // تبرعات
  GRANT // منح/دعم
  OTHER // أخرى
}

/// رسالة مباشرة بين عضوين في نفس الجهة
model Message {
  id        String    @id @default(cuid())
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  recipientId String
  recipient   User   @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([senderId])
  @@index([recipientId])
  @@map("messages")
}

/// فعالية/حدث في تقويم المؤسسة
model Event {
  id        String    @id @default(cuid())
  title     String
  details   String?
  startAt   DateTime
  endAt     DateTime?
  location  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("events")
}

/// وليّ الأمر — سجلّ يربط بحساب متابعة (اختياري) وبأبنائه الطلاب
model Guardian {
  id        String   @id @default(cuid())
  fullName  String
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // حساب دخول وليّ الأمر (اختياري) — لبوابة المتابعة
  userId String? @unique
  user   User?   @relation("GuardianAccount", fields: [userId], references: [id], onDelete: SetNull)

  students Student[]

  @@index([organizationId])
  @@map("guardians")
}

enum StudentStatus {
  ACTIVE // منتظم
  PAUSED // متوقّف مؤقتًا
  GRADUATED // متخرّج
  WITHDRAWN // منسحب
}

enum StudentSection {
  BOYS // بنين
  GIRLS // بنات
}

/// الحلقة / الفصل
model Halaqa {
  id        String        @id @default(cuid())
  name      String
  type      HalaqaType    @default(MEMORIZATION)
  track     HalaqaTrack? // قسم الحفظ/التلاوة
  period    HalaqaPeriod? // الفترة الصباحية/المسائية
  schedule  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  students     Student[]
  attendance   AttendanceRecord[]
  quranRecords QuranDailyRecord[]

  @@index([organizationId])
  @@index([teacherId])
  @@map("halaqat")
}

/// السجل اليومي القرآني — صف يوم واحد لطالب ضمن «الدليل الشهري»
model QuranDailyRecord {
  id         String           @id @default(cuid())
  date       DateTime         @db.Date
  attendance AttendanceStatus @default(PRESENT)

  newFrom      Int? // الدرس الجديد: من صفحة
  newTo        Int? // إلى صفحة
  newNote      String? // الشرح/السورة
  reviewFrom   Int? // المراجعة اليومية: من
  reviewTo     Int? // إلى
  last5From    Int? // آخر ٥ صفحات: من
  last5To      Int? // إلى
  listener     String? // اسم المستمع
  pages        Float? // عدد الصفحات
  errors       Int? // الأخطاء
  alerts       Int? // التنبيهات
  lessonScore  Int? // درجة الدرس
  reviewScore  Int? // درجة المراجعة اليومية
  minorScore   Int? // درجة المراجعة الصغرى
  conductScore Int? // درجة السلوك
  otherScore   Int? // درجة أخرى
  notes        String? // ملاحظات المعلم

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  halaqaId String?
  halaqa   Halaqa? @relation(fields: [halaqaId], references: [id], onDelete: SetNull)

  @@unique([studentId, date])
  @@index([organizationId])
  @@index([studentId])
  @@map("quran_daily_records")
}

enum HalaqaType {
  MEMORIZATION // تحفيظ
  TAJWEED // تجويد
  REVIEW // مراجعة
  OTHER // أخرى
}

/// مسار الحلقة — قسم الحفظ أو التلاوة
enum HalaqaTrack {
  MEMORIZATION // قسم الحفظ
  RECITATION // قسم التلاوة
}

/// فترة الحلقة — الصباحية أو المسائية
enum HalaqaPeriod {
  MORNING // الفترة الصباحية
  EVENING1 // الفترة المسائية الأولى
  EVENING2 // الفترة المسائية الثانية
}

/// سجل حضور — طالب في حلقة بتاريخ محدّد
model AttendanceRecord {
  id        String           @id @default(cuid())
  date      DateTime
  status    AttendanceStatus @default(PRESENT)
  createdAt DateTime         @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  halaqaId String
  halaqa   Halaqa @relation(fields: [halaqaId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([halaqaId, studentId, date])
  @@index([organizationId])
  @@index([studentId])
  @@map("attendance_records")
}

enum AttendanceStatus {
  PRESENT // حاضر
  ABSENT // غائب
  LATE // متأخّر
  EXCUSED // بعذر
}

/// سجل حفظ / تسميع
model MemorizationEntry {
  id        String             @id @default(cuid())
  date      DateTime           @default(now())
  kind      MemorizationKind   @default(NEW)
  content   String
  rating    MemorizationRating @default(GOOD)
  notes     String?
  createdAt DateTime           @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([studentId])
  @@map("memorization_entries")
}

enum MemorizationKind {
  NEW // حفظ جديد
  REVIEW // مراجعة
}

/// تقييم / اختبار لطالب — درجة ونتيجة
model Assessment {
  id        String           @id @default(cuid())
  title     String
  kind      AssessmentKind   @default(MEMORIZATION_TEST)
  score     Float? // الدرجة المحصّلة
  maxScore  Float            @default(100) // الدرجة القصوى
  errors    Int? // عدد الأخطاء
  alerts    Int? // عدد التنبيهات
  result    AssessmentResult @default(PENDING)
  date      DateTime         @default(now())
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([studentId])
  @@map("assessments")
}

enum AssessmentKind {
  MEMORIZATION_TEST // اختبار حفظ
  TAJWEED_TEST // اختبار تجويد
  RECITATION_TEST // اختبار تلاوة
  LEVEL_EXAM // اختبار مستوى
  OTHER // أخرى
}

enum AssessmentResult {
  PASS // ناجح
  FAIL // راسب
  PENDING // قيد التقييم
}

/// إعلان / خبر ضمن إدارة المحتوى
model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  pinned      Boolean  @default(false)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("announcements")
}

/// مسابقة حفظ/تجويد
model Competition {
  id           String    @id @default(cuid())
  name         String
  level        String? // المستوى: جزء عمّ، 5 أجزاء، القرآن كاملًا…
  description  String? // وصف المسابقة
  startDate    DateTime?
  endDate      DateTime? // تاريخ انتهاء التسجيل/المسابقة
  prize        String? // الجوائز
  location     String? // مكان الإقامة
  status       String    @default("UPCOMING") // UPCOMING / OPEN / CLOSED
  participants Int       @default(0)
  createdAt    DateTime  @default(now())

  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entrants       CompetitionParticipant[]

  @@index([organizationId])
  @@map("competitions")
}

/// مشارك في مسابقة — بدرجة وترتيب
model CompetitionParticipant {
  id        String   @id @default(cuid())
  name      String
  score     Int?
  rank      Int?
  note      String?
  createdAt DateTime @default(now())

  competitionId  String
  competition    Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([competitionId])
  @@index([organizationId])
  @@map("competition_participants")
}

/// سجلّ النشاط — تتبّع الإجراءات المهمّة
model AuditLog {
  id        String   @id @default(cuid())
  action    String // created / updated / deleted / approved / rejected …
  entity    String // task / request / student / module …
  label     String? // وصف الهدف
  actorName String
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("audit_logs")
}

enum MemorizationRating {
  EXCELLENT // ممتاز
  GOOD // جيد
  NEEDS_REPEAT // يحتاج إعادة
}

/// وحدة تنظيمية (إدارة / قسم / فرع) — شجرة تُبنى بالإسناد الذاتي parentId
model Department {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Department[] @relation("DepartmentTree")

  members       User[]
  projects      Project[]
  programs      Program[]
  campaigns     Campaign[]
  beneficiaries Beneficiary[]
  documents     Document[]
  employees     Employee[]
  teams         Team[]
  tasks         Task[]

  @@index([organizationId])
  @@index([parentId])
  @@map("departments")
}

/// البرنامج — نشاط مؤسسي مصنّف (تعليمي/إنساني/…) بسعة مستهدفة
model Program {
  id          String          @id @default(cuid())
  name        String
  description String?
  category    ProgramCategory @default(EDUCATIONAL)
  status      ProgramStatus   @default(ACTIVE)
  capacity    Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  beneficiaries Beneficiary[]

  @@index([organizationId])
  @@index([departmentId])
  @@map("programs")
}

/// المشروع — كيان يخصّ مؤسسة واحدة، أول الوحدات الوظيفية
model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANNED)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([departmentId])
  @@map("projects")
}

/// المستخدم — ينتمي لمؤسسة واحدة، أو لا ينتمي لأي منها إن كان مالك المنصة
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(MEMBER)
  isActive     Boolean   @default(true)
  avatarUrl    String?
  jobTitle     String?
  phone        String?
  lastLoginAt  DateTime?
  cardToken    String? // رمز البطاقة الرقمية (يُولّد عند أول إصدار) — عشوائي فريد عمليًا
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // دور مخصّص (اختياري) — إن وُجد فصلاحياته تتجاوز صلاحيات الدور الأساسي
  customRoleId String?
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  articles           KnowledgeArticle[]
  documents          Document[]
  tasks              Task[]               @relation("TaskAssignee")
  requests           MemberRequest[]      @relation("RequestRequester")
  teacherProfile     Teacher?             @relation("TeacherAccount")
  guardianProfile    Guardian?            @relation("GuardianAccount")
  studentProfile     Student?             @relation("StudentAccount")
  approvalsRequested Approval[]           @relation("ApprovalRequester")
  approvalsDecided   Approval[]           @relation("ApprovalDecider")
  financeEntries     FinanceTransaction[] @relation("FinanceCreator")
  sentMessages       Message[]            @relation("MessageSender")
  receivedMessages   Message[]            @relation("MessageRecipient")
  pointsCreated      PointsTransaction[]  @relation("PointsCreator")

  @@index([organizationId])
  @@index([departmentId])
  @@index([cardToken])
  @@index([customRoleId])
  @@map("users")
}

/// دور مخصّص داخل الجهة — اسم + قائمة قدرات (capabilities) يحدّدها مدير الجهة
model CustomRole {
  id          String   @id @default(cuid())
  name        String
  permissions String[] @default([]) // مفاتيح القدرات، مثل: projects.view، education.manage
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        User[]

  @@index([organizationId])
  @@map("custom_roles")
}

/// الحملة — حملة خيرية/موسمية/توعوية بهدف مالي ومتابعة
model Campaign {
  id          String         @id @default(cuid())
  name        String
  description String?
  type        CampaignType   @default(CHARITY)
  status      CampaignStatus @default(ACTIVE)
  goalAmount  Int?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  donations Donation[]

  @@index([organizationId])
  @@index([departmentId])
  @@map("campaigns")
}

/// المستفيد — ملف حالة تخدمه المؤسسة
model Beneficiary {
  id         String              @id @default(cuid())
  name       String
  phone      String?
  nationalId String?
  category   BeneficiaryCategory @default(FAMILY)
  status     BeneficiaryStatus   @default(ACTIVE)
  notes      String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  programId String?
  program   Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([departmentId])
  @@index([programId])
  @@map("beneficiaries")
}

/// التبرع — عملية مالية واردة، قد ترتبط بحملة
model Donation {
  id        String         @id @default(cuid())
  donorName String
  amount    Int
  method    DonationMethod @default(CASH)
  status    DonationStatus @default(RECEIVED)
  note      String?
  donatedAt DateTime       @default(now())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([campaignId])
  @@map("donations")
}

/// وثيقة مخزَّنة في مخزن متوافق مع S3 — نحفظ بياناتها الوصفية فقط
model Document {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String?
  fileKey     String   @unique // مفتاح الكائن في المخزن
  fileName    String // الاسم الأصلي
  contentType String
  size        Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([departmentId])
  @@map("documents")
}

/// مقالة في قاعدة المعرفة المؤسسية
model KnowledgeArticle {
  id          String   @id @default(cuid())
  title       String
  body        String
  category    String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("knowledge_articles")
}

/// إعدادات المحتوى العام للمنصّة — صفّ واحد (id = "main") يديره مالك المنصّة.
model PlatformSetting {
  id                 String   @id @default("main")
  heroTitle1         String? // عنوان البطل — السطر الأول
  heroTitle2         String? // عنوان البطل — السطر المميّز
  heroSubtitle       String? // وصف البطل
  homeFeatures       Json? // مميزات الصفحة الرئيسية (مصفوفة {title, desc}) — فارغة = افتراضي
  homeFaqs           Json? // الأسئلة الشائعة (مصفوفة {q, a}) — فارغة = افتراضي
  announcement       String? // شريط إعلان عام
  announcementLink   String? // وجهة الإعلان (مسار داخلي /x أو رابط خارجي https) — اختياري
  announcementActive Boolean  @default(false)
  contactEmail       String?
  contactPhone       String?
  whatsapp           String?
  twitterUrl         String?
  instagramUrl       String?
  updatedAt          DateTime @updatedAt

  @@map("platform_settings")
}

/// شريحة Hero في الصفحة الرئيسية — يديرها مالك المنصّة (CMS).
model HeroSlide {
  id        String     @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String?
  ctaText   String?
  ctaLink   String?
  order     Int        @default(0)
  status    HeroStatus @default(DRAFT)
  startAt   DateTime? // بداية العرض المجدول
  endAt     DateTime? // نهاية العرض
  enabled   Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, order])
  @@map("hero_slides")
}

enum HeroStatus {
  DRAFT // مسودّة
  PUBLISHED // منشور
  SCHEDULED // مجدول
  ARCHIVED // مؤرشف
}

/// خطة/مقرّر دراسي مخصّص تنشئه الجهة (بالإضافة إلى القوالب الجاهزة).
model StudyPlan {
  id             String   @id @default(cuid())
  title          String
  subtitle       String?
  description    String?
  tag            String?
  stages         Json? // مصفوفة مراحل: [{ t, d, meta }]
  createdAt      DateTime @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("study_plans")
}

enum OrgType {
  ASSOCIATION // جمعية أو مؤسسة
  MOSQUE // مسجد أو مركز قرآني
  SCHOOL // مركز تعليمي
  PROJECT // مشروع خاص
}

enum OrgPlan {
  STARTER // ستارتر
  GROWTH // غروث
  PROFESSIONAL // بروفيشنال
  ENTERPRISE // انتربرايز
}

enum Role {
  PLATFORM_OWNER // مالك المنصة — يرى كل المؤسسات
  ORG_ADMIN // مدير المؤسسة — يدير كل شيء داخلها
  STAFF // موظف — يعمل داخل المؤسسة بصلاحيات محددة
  MEMBER // مستخدم عادي — قراءة وتفاعل محدود
  SUPERVISOR // مشرف — يتابع البرامج والحلقات والمعلمين والطلاب حسب صلاحياته
  TEACHER // معلم — يدير حلقاته وطلابه ومتابعتهم
  STUDENT // طالب — يطّلع على ملفه وحضوره وتقدّمه وتقييماته
}

enum ProjectStatus {
  PLANNED // مخطّط
  ACTIVE // جارٍ
  ON_HOLD // متوقّف
  COMPLETED // مكتمل
  CANCELLED // ملغى
}

/// المهمة — عمل مُسنَد بحالة وأولوية ومسؤول وموعد
model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([assigneeId])
  @@index([departmentId])
  @@map("tasks")
}

enum TaskStatus {
  TODO // قيد الانتظار
  IN_PROGRESS // جارٍ التنفيذ
  BLOCKED // معطّل
  DONE // منجز
}

enum TaskPriority {
  LOW // منخفضة
  MEDIUM // متوسطة
  HIGH // عالية
  URGENT // عاجلة
}

/// طلب داخلي — يقدّمه عضو ويعتمده مدير المؤسسة
model MemberRequest {
  id        String        @id @default(cuid())
  type      RequestType
  status    RequestStatus @default(PENDING)
  details   String?
  reply     String? // ردّ المدير عند الاعتماد/الرفض
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  requesterId String
  requester   User   @relation("RequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([requesterId])
  @@map("member_requests")
}

enum RequestType {
  EXAM // طلب اختبار
  GRADE_EDIT // طلب تعديل درجات
  SUPERVISOR_MEETING // طلب اجتماع مع مراقب
  PERMISSION // طلب إذن
  MAKEUP_CLASS // طلب فتح فصل تعويض
  TEACHER_SERVICE // طلب خدمة للمعلمين
  DROPOUT_EXAM // اختبار المنقطعين
  OTHER // أخرى
}

enum RequestStatus {
  PENDING // قيد المراجعة
  APPROVED // معتمَد
  REJECTED // مرفوض
}

/// فرع تابع للمؤسسة — موقع/مكتب له مدير وبيانات تواصل
model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String? // رمز الفرع (اختياري)
  city      String?
  address   String?
  phone     String?
  manager   String? // اسم مدير الفرع
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("branches")
}

/// اعتماد — طلب موافقة يمرّ بسير عمل (قيد الاعتماد → معتمَد/مرفوض)
model Approval {
  id           String           @id @default(cuid())
  title        String
  description  String?
  category     ApprovalCategory @default(GENERAL)
  amount       Decimal?         @db.Decimal(12, 2) // مبلغ اختياري (للمشتريات/المدفوعات)
  status       ApprovalStatus   @default(PENDING)
  decisionNote String? // ملاحظة المُعتمِد عند القرار
  decidedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  requestedById String?
  requestedBy   User?   @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  decidedById String?
  decidedBy   User?   @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("approvals")
}

enum ApprovalCategory {
  PURCHASE // شراء
  PAYMENT // صرف/دفع
  LEAVE // إجازة
  CONTRACT // عقد/اتفاقية
  GENERAL // عام
}

enum ApprovalStatus {
  PENDING // قيد الاعتماد
  APPROVED // معتمَد
  REJECTED // مرفوض
}

enum ProgramCategory {
  EDUCATIONAL // تعليمي
  HUMANITARIAN // إنساني
  DEVELOPMENTAL // تنموي
  RELIGIOUS // ديني / قرآني
  HEALTH // صحي
}

enum ProgramStatus {
  PLANNED // مخطّط
  ACTIVE // جارٍ
  COMPLETED // منتهٍ
  SUSPENDED // موقوف
}

enum CampaignType {
  CHARITY // خيرية
  SEASONAL // موسمية
  AWARENESS // توعوية
}

enum CampaignStatus {
  PLANNED // مخطّطة
  ACTIVE // جارية
  COMPLETED // منتهية
  CANCELLED // ملغاة
}

enum BeneficiaryCategory {
  FAMILY // أسرة
  ORPHAN // يتيم
  STUDENT // طالب
  ELDERLY // مسنّ
  OTHER // أخرى
}

enum BeneficiaryStatus {
  ACTIVE // نشط
  PENDING // قيد المراجعة
  INACTIVE // موقوف
}

enum DonationMethod {
  CASH // نقداً
  BANK // تحويل بنكي
  CARD // بطاقة
  ONLINE // إلكتروني
}

enum DonationStatus {
  PLEDGED // متعهَّد به
  RECEIVED // مستلَم
}
